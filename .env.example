# Copy to .env and fill in. The app validates these at startup and refuses to
# boot with a message naming anything missing.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. On a serverless host use the pooled endpoint.
DATABASE_URL=postgresql://user:password@localhost:5432/gaboxapi

# Shared secret for the X-API-KEY header on every write endpoint.
API_MASTER_KEY=change-me

# ── Admin dashboard login (optional overrides) ────────────────────────────────
# The admin account itself is created with:
#   python -m scripts.create_admin
# There is no signup endpoint by design.

# Cookies are host-only and the API shares a registrable domain with the site
# (api.gabrielmayorga.dev / gabrielmayorga.dev), so requests from the dashboard
# are same-site and SameSite=Lax is sufficient.
# SESSION_COOKIE_NAME=gabox_session
# CSRF_COOKIE_NAME=gabox_csrf

# Leave on in every deployment. Browsers treat localhost as a secure context, so
# local development works with it enabled too. Only the test suite turns it off,
# because its base URL is plain http on a non-localhost host.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# Absolute session lifetime, and the inactivity cutoff (seconds).
# SESSION_MAX_AGE_SECONDS=43200
# SESSION_IDLE_SECONDS=7200

# Failed logins allowed per username or IP within the window (seconds).
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_ATTEMPT_WINDOW_SECONDS=900

# Send Strict-Transport-Security. Leave on for any HTTPS deployment.
# SECURITY_HSTS=true

# Whether X-Forwarded-For may be believed when identifying the caller. Correct
# behind a proxy that overwrites it, which Vercel does. Set this to false if the
# API is ever exposed directly: otherwise an attacker can forge the header and
# sidestep the login lockout by presenting a new address on every attempt.
# TRUST_PROXY_HEADERS=true

# ── Optional ──────────────────────────────────────────────────────────────────

# Log SQL statements. Useful locally, noisy in production.
SQL_ECHO=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated, or a JSON list. Defaults to localhost plus the portfolio
# domains; set this to override.
# CORS_ORIGINS=http://localhost:5173,https://gabrielmayorga.dev

# ── StatPitch ─────────────────────────────────────────────────────────────────
# All optional. Without ODDS_API_KEY the sync still stores predictions, it just
# cannot price them — and without a price there is no EV, no stake and no ROI.

# The StatPitch prediction service. It is stateless: this API is what persists
# its output and serves the frontend.
STATPITCH_BASE_URL=https://statpitch-api.onrender.com
# The free Render instance sleeps after ~15 minutes idle and the next call pays
# a cold start of tens of seconds. Do not shrink this to 5.
STATPITCH_TIMEOUT_SECONDS=60

# Which competitions to sync. These five are the ones with an odds market to
# price against; StatPitch covers seven more that get predictions but never a
# bet. Each added league costs one Odds API request per market per run.
STATPITCH_COMPETITIONS=ENG.PL,ESP.LALIGA,GER.BUNDESLIGA,ITA.SERIEA,FRA.LIGUE1

# The day the frontend calls "today" rolls over at local midnight here.
# Nicaragua is UTC-6 with no daylight saving, so that is 06:00 UTC.
STATPITCH_TIMEZONE=America/Managua
# Days kept either side of today: 1 means yesterday, today and tomorrow.
# Fixtures outside the window are deleted once their result is in the ledger.
STATPITCH_RETENTION_DAYS=1

# Real bookmaker prices and final scores. StatPitch supplies neither: its
# fair_odds are no-vig and unbettable, and it has no results endpoint at all.
ODDS_API_KEY=
ODDS_API_REGION=eu
# One request per market per league per run, against a 500/month free tier.
# h2h alone across five leagues is ~150/month; adding totals and btts takes it
# past 450 before scores are counted.
ODDS_API_MARKETS=h2h
# Empty averages every bookmaker in the region.
# ODDS_API_BOOKMAKERS=pinnacle,betfair
